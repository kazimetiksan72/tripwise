# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=fisgaranti

# Native iOS Sign in with Apple audience (must match ios.bundleIdentifier)
APPLE_IOS_BUNDLE_ID=com.pikselmutfak.tripwise

# Application sessions
SESSION_SECRET=

# OpenAI API key: configure as a Vercel Environment Variable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Used locally only by `npm run create-admin`; the hashed account is stored in MongoDB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
