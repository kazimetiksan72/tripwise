# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=fisgaranti

# Apple Sign in with Apple Services ID
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_REDIRECT_URI=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# Application session and admin allow-list (comma-separated Apple subject IDs)
SESSION_SECRET=
ADMIN_APPLE_SUBJECTS=
ADMIN_EMAILS=

# OpenAI API key: configure as a Vercel Environment Variable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
